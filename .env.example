# Copy to backend/.env  (never commit the real file)
# Optional AI features (resume improvement suggestions). Leave blank to use rule-based suggestions only.
GEMINI_API_KEY=your_key_here
# Use a model name available to your key (check Google AI Studio); the app does not hardcode one.
GEMINI_MODEL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: where the database, uploads and reports are stored (default: backend/data)
# RESUMATCH_DATA=
